{
  "manifest_version": 3,
  "name": "PokéSurvivor Build Assistant",
  "version": "0.3.8",
  "description": "Gợi ý build Partner, tự chọn skill, item và ghép Bond theo move set.",
  "author": "Jokervtn94",
  "permissions": ["storage"],
  "host_permissions": [
    "https://pokesurvivor.com/*",
    "https://pokesurvivors.org/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pokesurvivor.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
