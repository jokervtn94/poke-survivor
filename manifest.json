{
  "manifest_version": 3,
  "name": "PokéSurvivor Build Assistant",
  "version": "0.3.2",
  "description": "Theo dõi skill, gợi ý thẻ theo Pokémon và tự chọn thẻ dẫn điểm khi đạt điều kiện.",
  "author": "Jokervtn94",
  "permissions": ["storage"],
  "host_permissions": ["https://pokesurvivor.com/*"],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pokesurvivor.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
