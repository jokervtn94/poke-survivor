{
  "manifest_version": 3,
  "name": "PokéSurvivor Build Assistant",
  "version": "0.3.19",
  "description": "Tạo move set riêng từ pool move của Partner, rồi tự chọn thẻ và ghép Bond theo cấu hình đã xác nhận.",
  "author": "Jokervtn94",
  "permissions": ["storage"],
  "host_permissions": [
    "https://pokesurvivor.com/*",
    "https://pokesurvivors.org/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pokesurvivor.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
